{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sk-travel.org/schemas/universal-trip-data-v1.schema.json",
  "title": "SK-Travel Universal Trip Data v1",
  "description": "Open JSON representation carried inside the portable ZIP. Binary originals and photos are separate ZIP members referenced by archivePath and SHA-256.",
  "type": "object",
  "required": ["format", "schemaVersion", "exportedAt", "trip", "stops", "places", "guideRevisions", "sourceFiles", "photos", "history", "relationships"],
  "properties": {
    "format": {"const": "org.sk-travel.trip-data"},
    "schemaVersion": {"const": 1},
    "exportedAt": {"type": "string", "format": "date-time"},
    "trip": {"$ref": "#/$defs/trip"},
    "stops": {"type": "array", "items": {"$ref": "#/$defs/stop"}},
    "places": {"type": "array", "items": {"$ref": "#/$defs/place"}},
    "guideRevisions": {"type": "array", "items": {"type": "object", "required": ["guideRevisionId", "tripId", "placeId", "revisionNo", "format", "reviewStatus"], "properties": {"guideRevisionId": {"type": "string"}, "tripId": {"type": "string"}, "placeId": {"type": "string"}, "revisionNo": {"type": "integer", "minimum": 1}, "format": {"type": "string"}, "reviewStatus": {"type": "string"}, "guide": {"type": ["object", "null"]}, "text": {"type": "string"}, "sourceHash": {"type": "string"}, "active": {"type": "boolean"}}, "additionalProperties": true}},
    "sourceFiles": {"type": "object", "required": ["itineraries", "guides"], "properties": {"itineraries": {"type": "array", "items": {"$ref": "#/$defs/sourceFile"}}, "guides": {"type": "array", "items": {"$ref": "#/$defs/sourceFile"}}}, "additionalProperties": true},
    "photos": {"type": "array", "items": {"type": "object", "required": ["photoId", "tripId", "stopId", "placeId", "name", "mimeType", "size", "sha256", "archivePath"], "properties": {"photoId": {"type": "string"}, "tripId": {"type": "string"}, "stopId": {"type": "string"}, "placeId": {"type": "string"}, "name": {"type": "string"}, "mimeType": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"type": "string"}, "archivePath": {"type": "string"}, "note": {"type": "string"}, "addedAt": {"type": "string", "format": "date-time"}}, "additionalProperties": true}},
    "history": {"type": "array", "items": {"type": "object", "required": ["historyId", "tripId", "action", "at"], "properties": {"historyId": {"type": "string"}, "tripId": {"type": "string"}, "action": {"type": "string"}, "at": {"type": "string", "format": "date-time"}}, "additionalProperties": true}},
    "relationships": {"type": "object", "properties": {"stopToPlace": {"type": "array"}, "guideToPlace": {"type": "array"}, "photoToStop": {"type": "array"}, "sourceToTrip": {"type": "array"}}, "additionalProperties": true},
    "privacy": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "trip": {"type": "object", "required": ["tripId", "name"], "properties": {"tripId": {"type": "string"}, "name": {"type": "string"}, "startDate": {"type": "string"}, "endDate": {"type": "string"}, "notes": {"type": "string"}, "sourceHash": {"type": ["string", "null"]}}, "additionalProperties": true},
    "place": {"type": "object", "required": ["placeId", "name"], "properties": {"placeId": {"type": "string"}, "name": {"type": "string"}, "city": {"type": "string"}, "countryCode": {"type": "string"}, "coordinates": {"type": ["object", "null"]}, "identityStatus": {"type": "string"}}, "additionalProperties": true},
    "stop": {"type": "object", "required": ["stopId", "tripId", "placeId", "placeName", "dayOrder", "eventOrder"], "properties": {"stopId": {"type": "string"}, "tripId": {"type": "string"}, "placeId": {"type": "string"}, "placeName": {"type": "string"}, "date": {"type": "string"}, "dayOrder": {"type": "integer", "minimum": 0}, "eventOrder": {"type": "integer", "minimum": 0}, "startTime": {"type": "string"}, "endTime": {"type": "string"}, "durationMin": {"type": ["number", "null"], "minimum": 0}, "city": {"type": "string"}, "countryCode": {"type": "string"}, "category": {"type": "string"}, "notes": {"type": "string"}, "completed": {"type": "boolean"}}, "additionalProperties": true},
    "sourceFile": {"type": "object", "required": ["fileId", "tripId", "name", "mimeType", "size", "sha256", "archivePath"], "properties": {"fileId": {"type": "string"}, "tripId": {"type": "string"}, "name": {"type": "string"}, "mimeType": {"type": "string"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"type": "string"}, "archivePath": {"type": "string"}, "immutable": {"type": "boolean"}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
